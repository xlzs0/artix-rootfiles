color-link default "#D5D8DA,#0E0E0E"
color-link comment "italic #3F3F3F,#0E0E0E"

color-link identifier "#D44F6E,#0E0E0E"
color-link identifier.class "#FDB849,#0E0E0E"
color-link identifier.var "#D44F6E,#0E0E0E"
color-link identifier.macro "#A4A4A4,#0E0E0E"

color-link constant "#EAAC8B,#0E0E0E"
color-link constant.number "#EAAC8B,#0E0E0E"
color-link constant.string "#EAAC8B,#0E0E0E"
color-link constant.specialChar "#EAAC8B,#0E0E0E"
color-link constant.bool "#EAAC8B,#0E0E0E"
color-link constant.bool.true "#EAAC8B,#0E0E0E"
color-link constant.bool.false "#EAAC8B,#0E0E0E"

color-link statement "#46ACAD,#0E0E0E"
color-link symbol "#A4A4A4,#0E0E0E"
color-link symbol.brackets "#A4A4A4,#0E0E0E"
color-link symbol.operator "#46ACAD,#0E0E0E"
color-link symbol.tag "#E3B08C,#0E0E0E"
color-link preproc "#A4A4A4,#0E0E0E"
color-link preproc.shebang "#A4A4A4,#0E0E0E"
color-link type "#E3B08C,#0E0E0E"
color-link type.keyword "#46ACAD,#0E0E0E"
color-link special "#FDB849,#0E0E0E"
color-link underlined "underline #46ACAD,#0E0E0E"

color-link error "bold #0E0E0E,#F43E5C"
color-link todo "bold #FDB849,#0E0E0E"
color-link selection "#D5D8DA,#1E1F26"

color-link statusline "#D5D8DA,#2E303E"
color-link statusline.inactive "#727374,#1C1E26"
color-link statusline.suggestions "#D5D8DA,#1E1F26"
color-link tabbar "#D5D8DA,#0E0E0E"
color-link tabbar.active "#D5D8DA,#2E303E"

color-link indent-char "#141414,#0E0E0E"
color-link line-number "#4A4B4C,#0E0E0E"
color-link gutter-info "#1B8A8C,#0E0E0E"
color-link gutter-error "#F43E5C,#0E0E0E"
color-link gutter-warning "#209B6E,#0E0E0E"
color-link diff-added "#0AB274"
color-link diff-modified "#1B8A8C"
color-link diff-deleted "#AF3045"
color-link cursor-line "#080808"
color-link current-line-number "#727374,#0E0E0E"
color-link color-column "#141414"
color-link ignore "#4A4B4C,#0E0E0E"
color-link scrollbar "#2A2B36,#0E0E0E"
color-link divider "#1A1C23,#0E0E0E"
color-link message "#D5D8DA,#0E0E0E"
color-link error-message "#F43E5C,#0E0E0E"
color-link match-brace "#D5D8DA,#3D3F51"
color-link hlsearch "#D5D8DA,#321543"
color-link tab-error "#F43E5C"
