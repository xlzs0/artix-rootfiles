pkgname=sbase-select
pkgver=1
pkgrel=1
pkgdesc='Few utilities from sbase'
arch=('x86_64')
url='https://git.suckless.org/sbase'
license=('MIT')
makedepends=(
	'git'
	'musl'
	'clang'
)
source=("$pkgname::git://git.suckless.org/sbase")
sha256sums=('SKIP')

_utils=(join pathchk unexpand)

pkgver() {
	cd "$pkgname"
	printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
	cd "$pkgname"
	make CC=musl-clang LDFLAGS='-s -static' "${_utils[@]}"
}

package() {
	cd "$pkgname"
	for u in "${_utils[@]}"; do
		install -Dm755 "$u" "$pkgdir/usr/local/bin/$u"
	done
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
