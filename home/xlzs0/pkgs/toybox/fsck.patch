     j++;
   }
-  args[i] = finfo->device;
+  args[i] = resolve_device(finfo->device);
+  if (!args[i]) args[i] = xstrdup(finfo->device);
 
   TT.nr_run++;
   if ((toys.optflags & FLAG_V) || (toys.optflags & FLAG_N)) {
