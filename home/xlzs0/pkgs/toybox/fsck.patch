+static char *resolve_device(char *dev)
+{
+  char *s, *flag = 0;
+  if (strstart(&dev, "UUID=")) flag = "-U";
+  else if (strstart(&dev, "LABEL=")) flag = "-L";
+  if (!flag) return 0;
+  fflush(0);
+  s = chomp(xrunread((char *[]){"blkid", flag, dev, 0}, 0));
+  if (!s || strlen(s) >= sizeof(toybuf)) {
+    error_msg("No %s %s", flag+1, dev);
+    return 0;
+  }
+  return s;
+}
+
 // find type and execute corresponding fsck.type prog.
 static void do_fsck(struct f_sys_info *finfo)
 {
