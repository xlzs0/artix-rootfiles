install=toybox.install

prepare() {
	cd "${srcdir}/${pkgname}-${pkgver}"

	cp $srcdir/usermod.c $srcdir/toybox-$pkgver/toys/other/usermod.c
	cp $srcdir/groupmod.c $srcdir/toybox-$pkgver/toys/pending/groupmod.c

	patch -p1 < $srcdir/passwd.patch
	patch -p1 < $srcdir/mount-scanall.patch
	sed -i '/generated\/Config\.probed: generated\/Config\.in/a generated\/unstripped\/kconfig: generated\/Config.in' Makefile

	# TODO: submit to upstream as proper patches?

	# update_password truncating files on open
	sed -i 's/fopen(filename, "w+")/fopen(filename, "r+")/' lib/password.c

	# inverted match condition never matching users
	sed -i "s/!(line\[len\] && line\[len\]!=':')/line[len] != ':'/" lib/password.c

	# use after free when getline's out buffer==line
	sed -i '/^\s*free(out);$/d' lib/password.c

	# off by one in field replacement
	sed -i 's/if (pos>=0) out = line;/if (pos>0) out = line;/' lib/password.c

	# xmprintf padding instead of truncating
	sed -i 's/xmprintf("%\*s%s%s\\n"/xmprintf("%.*s%s%s\\n"/' lib/password.c

	# stdout not flushed before reading stdin
	sed -i '/xprintf("Login shell for/a\    fflush(stdout);' toys/pending/chsh.c

	# sucky: use blkid to detect fs type before falling back to /proc/filesystems
	sed -i 's/} else fp = xfopen("\/proc\/filesystems", "r");/} else {\n      char *blktype = chomp(xrunread((char *[]){"blkid", "-o", "value", "-s", "TYPE", dev, 0}, 0));\n      if (blktype) type = blktype;\n      else fp = xfopen("\/proc\/filesystems", "r");\n    }/' toys/lsb/mount.c
}

build() {
	cd "${srcdir}/${pkgname}-${pkgver}"

	CC=musl-clang make allnoconfig

	local opts=(
  		# coreutils
		base32 base64 basename cat chgrp chmod chown chroot cksum comm cp crc32 cut
		date dd df dirname du echo env expand expr factor false fmt fold groups
		head id install link ln logname ls md5sum mkdir mkfifo mknod mktemp mv nice
		nl nohup nproc od paste printenv printf pwd readlink realpath rm rmdir
		seq sha1sum sha224sum sha256sum sha384sum sha3sum sha512sum shred shuf
		sleep sort split stat sync tac tail tee test timeout touch true truncate
		tr tsort tty uname uniq unlink wc who whoami yes

		# util-linux
		getty blkdiscard blkid blockdev cal chrt chsh dmesg eject fallocate
		fdisk flock fsck fsfreeze getopt hexdump hwclock ionice ipcrm kill last
		linux32 logger login losetup mcookie mkswap more mount mountpoint
		nologin nsenter pivot_root renice rev rfkill rtcwake setsid su sulogin
		swapoff swapon switch_root taskset uclampset umount unshare uuidgen

		# procps-ng
		free pgrep pidof pkill pmap ps pwdx sysctl top uptime vmstat w watch

		# tar
		tar

		# grep
		egrep fgrep grep

		# gawk
		awk

		# sed
		sed

		# findutils
		find xargs

		# which
		which

		# patch
		patch

		# diffutils
		cmp diff

		# gzip
		gzip gunzip zcat

		# xxd
		xxd

		# cpio
		cpio

		# time
		time

		# wget
		wget

		# vi
		vi

		# shadow
		groupadd groupdel groupmod passwd useradd userdel usermod

		# cfg
		TOYBOX_SUID
		TOYBOX_HELP
		TOYBOX_HELP_DASHDASH
		TOYBOX_FLOAT
	)

	for opt in "${opts[@]}"; do
		local sym="CONFIG_$(echo "$opt" | tr 'a-z' 'A-Z')"
		sed -i "s/# ${sym} is not set/${sym}=y/" .config
	done

	CC=musl-clang \
	CFLAGS='-Wno-unused-command-line-argument' \
	LDFLAGS="-static -lm" \
	make
}

mkwrap() { printf '#!/bin/sh\nexec %s "$@"\n' "$2" > "$1" && chmod 755 "$1"; }

package() {
	cd "${srcdir}/${pkgname}-${pkgver}"

	PREFIX="${pkgdir}" make install

	for dir in "${pkgdir}/bin" "${pkgdir}/sbin" "${pkgdir}/usr/sbin"; do
		[[ -d "$dir" ]] && mv "$dir"/* "${pkgdir}/usr/bin/" && rmdir "$dir"
	done



	mkwrap "${pkgdir}/usr/bin/agetty" getty
	mkwrap "${pkgdir}/usr/bin/gawk" awk

	chmod u+s "${pkgdir}/usr/bin/toybox"

	install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
